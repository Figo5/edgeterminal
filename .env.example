# ---- EdgeTerminal configuration -------------------------------------------
# Copy to .env and fill in what you have. Everything is optional except
# OPENAI_API_KEY (needed only for the AI chat / research synthesis).

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Database
DATABASE_URL=sqlite:///./data/edgeterminal.db

# Odds: auto | espn | theoddsapi | demo. Auto tries The Odds API when keyed,
# then ESPN's free scoreboard consensus markets, then clearly labeled demo data.
ODDS_PROVIDER=auto
ODDS_API_KEY=
# Research-only NFL player-prop capture. Used only by the explicit capture command.
SPORTSGAMEODDS_API_KEY=
ODDS_REGIONS=us,uk
PREFERRED_BOOKS=fanduel,bet365

# Stats: ESPN summaries plus locally cached nflverse PBP features when present.
# Normal app refresh never downloads the season archive. See README for acquisition.
STATS_PROVIDER=auto
NFLVERSE_CACHE_DIR=./data/nflverse/pbp
NEWS_PROVIDER=auto
INJURY_PROVIDER=auto

# Weather: openmeteo (free, no key) | demo | auto
WEATHER_PROVIDER=auto

# Web search: none | duckduckgo | tavily | brave
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_API_KEY=

# Demo mode forces every provider to fixtures and labels the UI "DEMO DATA".
DEMO_MODE=false

# Thresholds
OFFICIAL_PICK_CONFIDENCE=80
LEAN_CONFIDENCE=65
MIN_EDGE_PCT=2.0
ODDS_STALE_SECONDS=900

# Server
HOST=127.0.0.1
PORT=8799

# Local timezone used to interpret "tonight", "Thursday night", etc.
TIMEZONE=America/New_York

# How old the stored schedule may be before a relative-date question refreshes
# it once before resolving. The events endpoint used for this costs no Odds API
# quota. Nothing polls in the background; this only runs on a user request.
SCHEDULE_STALE_SECONDS=21600
