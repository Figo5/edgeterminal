# Nonsecret Compose settings. Keep actual service env files outside the checkout.
EDGETERMINAL_CODE_DIR=/srv/edgeterminal/app
EDGETERMINAL_RUNTIME=always_on
EDGETERMINAL_STATE_DIR=/srv/edgeterminal/state
EDGETERMINAL_REVISION=REPLACE_WITH_REVIEWED_40_CHARACTER_COMMIT
EDGETERMINAL_PUBLIC_URL=https://REPLACE_WITH_PRIVATE_HOSTNAME
EDGETERMINAL_WEB_ENV_FILE=/etc/edgeterminal/web.env
EDGETERMINAL_WORKER_ENV_FILE=/etc/edgeterminal/worker.env
